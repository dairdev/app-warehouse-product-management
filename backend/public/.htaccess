<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security: Disable directory browsing
    Options -Indexes

    # Enable HTTP Authorization header passing in PHP
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # If the requested file or directory exists physically, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # For any route that is NOT a real file or directory, redirect to index.php
    # Works seamlessly in root subdomain (tienda.example.com) or subfolder (/tienda)
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security: Deny direct HTTP access to database files, .env, configs, and lockfiles
<FilesMatch "(^\.env|\.(sqlite|sqlite3|db|env|lock|md|yml|yaml|ini|log|sh)$)">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<Files ".env">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Optional GZIP Compression for fast asset loading on Apache
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Caching headers for static Vite assets (JS, CSS, images)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>
