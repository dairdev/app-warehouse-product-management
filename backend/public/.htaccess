<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Security: Disable directory browsing
    Options -Indexes

    # Enable HTTP Authorization header passing in PHP
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # If the requested file or directory exists physically, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # For any route that is NOT a real file or directory, redirect to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Optional GZIP Compression for fast asset loading on Apache
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Caching headers for static Vite assets (JS, CSS, images)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
